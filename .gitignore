# ============================================================
# FraudShield - .gitignore (monorepo)
# ============================================================

# --- Entornos virtuales (Poetry, un .venv por servicio) ---
.venv/
venv/
env/
ENV/

# --- Secretos y configuración local ---
# Se versiona .env.example (sin valores reales), nunca .env
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.eggs/
build/
dist/
*.whl

# --- Caches de herramientas ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.import_linter_cache/
.hypothesis/
.ipynb_checkpoints/

# --- Cobertura y reportes de pruebas ---
.coverage
.coverage.*
coverage.xml
htmlcov/
junit*.xml

# --- Claude Code (configuración personal; settings.json SÍ se versiona) ---
.claude/settings.local.json
CLAUDE.local.md

# --- Base de datos local y volúmenes de Docker ---
*.sqlite
*.sqlite3
*.db
pgdata/
infra/data/
infra/volumes/
infra/n8n/data/

# --- Machine learning: datos y artefactos pesados ---
# Los datasets y modelos entrenados no van al repo; se regeneran con los scripts
data/raw/
data/processed/
*.csv
*.parquet
*.pkl
*.joblib
*.onnx
mlruns/

# --- Power BI ---
*.pbix.bak
*.pbi/
.pbi/

# --- Node (si usas n8n o herramientas JS) ---
node_modules/

# --- Logs y temporales ---
*.log
logs/
tmp/
temp/

# --- IDEs y editores ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini