GATEWAY_LOG_LEVEL=INFO

# JWT
GATEWAY_JWT_SECRET=change-me-dev-only-at-least-32-chars-long
GATEWAY_JWT_ALGORITHM=HS256
GATEWAY_JWT_TTL_SECONDS=3600
GATEWAY_JWT_ISSUER=fraudshield-api-gateway

# Users: CSV of "username:bcrypt_hash:analyst_uuid" (see README for how to produce the bcrypt hash)
GATEWAY_USERS=kevin:$2b$12$4Qz3rmYpxZmQ3C6Lw8l0deKqkV8HkJmQ6V6zW3G8zXp4S6Fv9yKyS:11111111-1111-1111-1111-111111111111

# Posting-side API key: upstream systems posting transactions auth with this (not JWT).
GATEWAY_POSTING_API_KEY=dev-posting-key-change-me

# Downstream service base URLs
GATEWAY_TRANSACTION_SERVICE_URL=http://localhost:8001
GATEWAY_SCORING_SERVICE_URL=http://localhost:8002
GATEWAY_ALERT_SERVICE_URL=http://localhost:8003
GATEWAY_ANALYTICS_SERVICE_URL=http://localhost:8004

# Analytics uses its own API key for the Web/JSON connector. The gateway injects it
# on every /analytics/* request so analysts only need the JWT.
GATEWAY_ANALYTICS_API_KEY=dev-powerbi-key-change-me

GATEWAY_HTTP_TIMEOUT_SECONDS=10
