[importlinter]
root_package = alert
include_external_packages = True

[importlinter:contract:layers]
name = Layers of DDD point inward
type = layers
layers =
    alert.interfaces
    alert.infrastructure
    alert.application
    alert.domain
    alert.kernel

[importlinter:contract:domain-pure]
name = Domain does not depend on frameworks
type = forbidden
source_modules =
    alert.domain
forbidden_modules =
    fastapi
    sqlalchemy
    aiokafka
    pydantic
    shared_contracts

[importlinter:contract:application-pure]
name = Application does not depend on infrastructure or interfaces
type = forbidden
source_modules =
    alert.application
forbidden_modules =
    alert.infrastructure
    alert.interfaces
    fastapi
    sqlalchemy
    aiokafka
