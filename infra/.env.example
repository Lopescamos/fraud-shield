# ──────────────────────────────────────────────────────────────
# FraudShield — variables de infraestructura (docker compose)
# Copia este archivo como `.env` en la misma carpeta y ajusta valores.
# NO subir `.env` real al repositorio (ya está en .gitignore).
# ──────────────────────────────────────────────────────────────

# PostgreSQL — administrador (crea esquemas y usuarios por servicio)
POSTGRES_DB=fraudshield
POSTGRES_ADMIN_USER=admin
POSTGRES_ADMIN_PASSWORD=admin
POSTGRES_HOST_PORT=5432

# Contraseñas por servicio (solo desarrollo local)
TX_USER_PASSWORD=dev_tx
SCORING_USER_PASSWORD=dev_scoring
ALERTS_USER_PASSWORD=dev_alerts
ANALYTICS_USER_PASSWORD=dev_analytics

# Kafka — se habilita cuando el primer servicio empiece a publicar
KAFKA_HOST_PORT=9092

# n8n — se habilita en la fase de alertas
N8N_USER=admin
N8N_PASSWORD=admin
N8N_HOST_PORT=5678
